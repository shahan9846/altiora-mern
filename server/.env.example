PORT=5000
# Local MongoDB, or paste your MongoDB Atlas connection string here
MONGODB_URI=mongodb://127.0.0.1:27017/altiora_mern
# Origin of the React app (used for CORS)
CLIENT_URL=http://localhost:5173
# Long random string used to sign admin login tokens, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=
# Dashboard login, created by `npm run create-admin`
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Enquiry emails (Brevo, https://www.brevo.com): an API key and a sender address verified in Brevo (Senders).
# NOTIFY_EMAIL is who receives new enquiries; it can be changed later in the dashboard (Notifications).
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Altiora Website
NOTIFY_EMAIL=
# Production (Render): CLIENT_URL must be the exact address of the website, e.g. https://altiora-test.netlify.app
# (several allowed, separated by commas). NODE_ENV=production is optional.
